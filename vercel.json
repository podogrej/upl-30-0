{
  "ignoreCommand": "p=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^};git cat-file -e $p^{commit}||exit 1;git diff --quiet $p HEAD -- . ':!*.md' ':!docs' ':!tools' ':!sql' ':!data' ':!.github' ':!.claude'",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "30 0 * * *"
    }
  ],
  "functions": {
    "api/backup.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/r/:id",
      "destination": "/api/r?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
        }
      ]
    },
    {
      "source": "/pool.(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icon-180.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
