{
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)*.md' ':(exclude)docs' ':(exclude)tools' ':(exclude)sql' ':(exclude)data' ':(exclude).github' ':(exclude).claude'",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "30 0 * * *"
    }
  ],
  "functions": {
    "api/backup.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/r/:id",
      "destination": "/api/r?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/pool.(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icon-180.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
