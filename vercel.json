{
  "ignoreCommand": "p=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^};[ \"$p\" = \"$VERCEL_GIT_COMMIT_SHA\" ]&&exit 1;git cat-file -e $p^{commit}||exit 1;git diff --quiet $p HEAD -- . ':!*.md' ':!docs' ':!tools' ':!sql' ':!data' ':!.github' ':!.claude'",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "30 0 * * *"
    }
  ],
  "functions": {
    "api/backup.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/t",
      "destination": "/?utm_source=threads&utm_medium=social&utm_campaign=comment",
      "statusCode": 302
    },
    {
      "source": "/tp",
      "destination": "/?utm_source=threads&utm_medium=social&utm_campaign=post",
      "statusCode": 302
    },
    {
      "source": "/tb",
      "destination": "/?utm_source=threads&utm_medium=social&utm_campaign=bio",
      "statusCode": 302
    },
    {
      "source": "/to",
      "destination": "/?utm_source=threads&utm_medium=outreach",
      "statusCode": 302
    },
    {
      "source": "/tg",
      "destination": "/?utm_source=telegram&utm_medium=social&utm_campaign=post",
      "statusCode": 302
    },
    {
      "source": "/ig",
      "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=bio",
      "statusCode": 302
    },
    {
      "source": "/tt",
      "destination": "/?utm_source=tiktok&utm_medium=social&utm_campaign=bio",
      "statusCode": 302
    },
    {
      "source": "/tr/:name([a-z0-9-]{1,48})",
      "destination": "/?utm_source=tribuna&utm_medium=blog&utm_campaign=:name",
      "statusCode": 302
    }
  ],
  "rewrites": [
    {
      "source": "/r/:id",
      "destination": "/api/r?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'sha256-EVB23NB+udGHSHnSKCwGZqg04OvL78bfXclc9b67zeM=' 'sha256-RpSYOEFeyVJ5Bd3nll6OGJzFKFGx1yO11J4W3Ik5+aI=' 'sha256-YkW9euIk6BLj7wQGfAdL1VUS6k9YWyXeIhwhLXRtBsk=' 'sha256-k4m/e5FIc7NIlvaOVRoGGiMaqXVyCfddiY4Rj6N21gc=' 'sha256-naKSGKLEJxoYnYpRDiJZ/HsqhluKxmM4OEF0jwIX5aU=' 'sha256-wsxmTGzDAHbI7nCP69YBZB5wuXs27pMd+ry4SnCg798=' https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/ https://telegram.org https://www.clarity.ms https://scripts.clarity.ms; object-src 'none'; base-uri 'none'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; report-uri /api/err?csp=1"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'sha256-EVB23NB+udGHSHnSKCwGZqg04OvL78bfXclc9b67zeM=' 'sha256-RpSYOEFeyVJ5Bd3nll6OGJzFKFGx1yO11J4W3Ik5+aI=' 'sha256-YkW9euIk6BLj7wQGfAdL1VUS6k9YWyXeIhwhLXRtBsk=' 'sha256-k4m/e5FIc7NIlvaOVRoGGiMaqXVyCfddiY4Rj6N21gc=' 'sha256-naKSGKLEJxoYnYpRDiJZ/HsqhluKxmM4OEF0jwIX5aU=' 'sha256-wsxmTGzDAHbI7nCP69YBZB5wuXs27pMd+ry4SnCg798=' https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/ https://telegram.org https://www.clarity.ms https://scripts.clarity.ms; object-src 'none'; base-uri 'none'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; report-uri /api/err?csp=1"
        }
      ]
    },
    {
      "source": "/pool.(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icon-180.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
